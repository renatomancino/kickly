# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Stato di risoluzione SwiftPM salvato da Xcode dentro lo workspace condiviso
# (project.xcworkspace/xcshareddata/swiftpm/, project.xcworkspace/xcuserdata/):
# percorso diverso da .swiftpm/ sopra, quindi non coperto da quella riga.
# Rigenerato ad ogni apertura del progetto in Xcode/simulatore, comparso come
# non tracciato in ogni `git status` di questa sessione senza mai essere
# davvero utile da versionare.
**/xcshareddata/swiftpm/
**/xcuserdata/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
config.local.json

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/
