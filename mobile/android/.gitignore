# build.gradle.kts redirects Gradle's output to ../build (mobile/build/, already
# covered by mobile/.gitignore), so this never matches current builds. Kept as a
# safety net for stray/leftover build dirs (e.g. from IDE-driven builds or if the
# redirect config ever changes) that would otherwise show up as untracked.
build/

